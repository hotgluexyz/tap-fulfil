# Fulfil Configuration
# Copy this file to .env and fill in your actual values.
# Variable names follow the tap's setting keys; run `tap-fulfil --about` for the
# authoritative list.

# Required: Access key used to authenticate against Fulfil
TAP_FULFIL_ACCESS_KEY=your_access_key_here

# Optional: The earliest record date to sync (ISO-8601)
TAP_FULFIL_START_DATE=2023-01-01T00:00:00Z

# Optional: API base URL (defaults to https://dev.fulfil.io/api/v2)
TAP_FULFIL_API_URL=https://dev.fulfil.io/api/v2

# Optional: Hotglue connector API root. Takes precedence over TAP_FULFIL_API_URL.
TAP_FULFIL_BASE_URL=https://dev.fulfil.io/api/v2
